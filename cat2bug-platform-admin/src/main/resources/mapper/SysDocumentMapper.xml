<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cat2bug.system.mapper.SysDocumentMapper">

    <resultMap id="SysDocumentResult" type="com.cat2bug.common.domain.SysDocument">
        <result property="docId" column="doc_id"/>
        <result property="projectId" column="project_id"/>
        <result property="docName" column="doc_name"/>
        <result property="docType" column="doc_type"/>
        <result property="fileExtension" column="file_extension"/>
        <result property="createTime" column="create_time"/>
        <result property="createById" column="create_by_id"/>
        <result property="updateTime" column="update_time"/>
        <result property="updateById" column="update_by_id"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateByAvatar" column="update_by_avatar"/>
        <result property="fileVersion" column="file_version"/>
        <result property="docPid" column="doc_pid"/>
        <result property="docRemakr" column="doc_remakr"/>
        <result property="fileUrl" column="file_url"/>
        <result property="leaf" column="leaf"/>
    </resultMap>

    <sql id="selectSysDocumentVo">
        select d.doc_id, d.project_id, d.doc_name, d.doc_type, d.file_extension, d.create_time, d.create_by_id,
               d.update_time, d.update_by_id, d.file_version, d.doc_pid, d.doc_remakr, d.file_url,
               u.nick_name as update_by, u.avatar as update_by_avatar,
               case when l.pid_count > 0 then false else true end as leaf
        from sys_document d
                 left join sys_user u on u.user_id = d.update_by_id
                 left join (select doc_pid, count(doc_pid) as pid_count
                            from sys_document
                            where doc_type = 0
                            group by doc_pid) l on d.doc_id = l.doc_pid
    </sql>

    <sql id="selectSysDocumentWhere">
        <where>
            <if test="query.docId != null">
                and d.doc_id != #{query.docId}
            </if>
            <if test="query.projectId != null">
                and d.project_id = #{query.projectId}
            </if>
            <if test="query.docName != null and query.docName != ''">
                and d.doc_name like concat('%', #{query.docName}, '%')
            </if>
            <if test="query.exactDocName != null and query.exactDocName != ''">
                and d.doc_name = #{query.exactDocName}
            </if>
            <if test="query.docType != null">
                and d.doc_type = #{query.docType}
            </if>
            <if test="query.fileExtension != null and query.fileExtension != ''">
                and d.file_extension = #{query.fileExtension}
            </if>
            <if test="query.createById != null">
                and d.create_by_id = #{query.createById}
            </if>
            <if test="query.updateById != null">
                and d.update_by_id = #{query.updateById}
            </if>
            <choose>
                <when test="query.docPid == null">
                </when>
                <when test="query.docPid > 0">
                    and d.doc_pid = #{query.docPid}
                </when>
                <otherwise>
                    and (d.doc_pid is null or d.doc_pid &lt;= 0)
                </otherwise>
            </choose>
        </where>
    </sql>

    <select id="countSysDocumentList" resultType="long">
        select count(*)
        from sys_document d
        <include refid="selectSysDocumentWhere"/>
    </select>

    <select id="selectSysDocumentList" resultMap="SysDocumentResult">
        <include refid="selectSysDocumentVo"/>
        <include refid="selectSysDocumentWhere"/>
        <bind name="_pageOrder" value="@com.cat2bug.framework.web.PageOrder@current('update_by_name=u.nick_name')"/>
        <choose>
            <when test="_pageOrder != null">order by ${_pageOrder}</when>
            <otherwise>order by d.doc_type asc, d.create_time desc</otherwise>
        </choose>
        limit #{limit} offset #{offset}
    </select>

    <select id="selectSysDocumentByDocId" resultMap="SysDocumentResult">
        <include refid="selectSysDocumentVo"/>
        where d.doc_id = #{docId}
    </select>

    <insert id="insertSysDocument" useGeneratedKeys="true" keyProperty="docId">
        insert into sys_document
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="projectId != null">project_id,</if>
            <if test="docName != null and docName != ''">doc_name,</if>
            <if test="docType != null">doc_type,</if>
            <if test="fileExtension != null">file_extension,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createById != null">create_by_id,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="updateById != null">update_by_id,</if>
            <if test="fileVersion != null">file_version,</if>
            <if test="docPid != null">doc_pid,</if>
            <if test="docRemakr != null">doc_remakr,</if>
            <if test="fileUrl != null and fileUrl != ''">file_url,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="projectId != null">#{projectId},</if>
            <if test="docName != null and docName != ''">#{docName},</if>
            <if test="docType != null">#{docType},</if>
            <if test="fileExtension != null">#{fileExtension},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createById != null">#{createById},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="updateById != null">#{updateById},</if>
            <if test="fileVersion != null">#{fileVersion},</if>
            <if test="docPid != null">#{docPid},</if>
            <if test="docRemakr != null">#{docRemakr},</if>
            <if test="fileUrl != null and fileUrl != ''">#{fileUrl},</if>
        </trim>
    </insert>

    <update id="updateSysDocument">
        update sys_document
        <trim prefix="SET" suffixOverrides=",">
            <if test="projectId != null">project_id = #{projectId},</if>
            <if test="docName != null and docName != ''">doc_name = #{docName},</if>
            <if test="docType != null">doc_type = #{docType},</if>
            <if test="fileExtension != null">file_extension = #{fileExtension},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="createById != null">create_by_id = #{createById},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateById != null">update_by_id = #{updateById},</if>
            <if test="fileVersion != null">file_version = #{fileVersion},</if>
            <if test="docPid != null">doc_pid = #{docPid},</if>
            <if test="docRemakr != null">doc_remakr = #{docRemakr},</if>
            <if test="fileUrl != null and fileUrl != ''">file_url = #{fileUrl},</if>
        </trim>
        where doc_id = #{docId}
    </update>

    <delete id="deleteSysDocumentByDocId">
        delete from sys_document where doc_id = #{docId}
    </delete>

    <delete id="deleteSysDocumentByDocIds">
        delete from sys_document where doc_id in
        <foreach item="docId" collection="docIds" open="(" separator="," close=")">
            #{docId}
        </foreach>
    </delete>
</mapper>
