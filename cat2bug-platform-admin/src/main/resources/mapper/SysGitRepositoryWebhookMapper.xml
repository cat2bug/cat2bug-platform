<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cat2bug.system.mapper.SysGitRepositoryWebhookMapper">

    <resultMap type="com.cat2bug.common.domain.SysGitRepositoryWebhook" id="SysGitRepositoryWebhookResult">
        <result property="webhookId"      column="webhook_id" />
        <result property="repositoryId"   column="repository_id" />
        <result property="url"            column="url" />
        <result property="alias"          column="alias" />
        <result property="secretCipher"   column="secret_cipher" />
        <result property="events"         column="events" />
        <result property="active"         column="active" />
        <result property="createBy"       column="create_by" />
        <result property="createTime"     column="create_time" />
        <result property="updateBy"       column="update_by" />
        <result property="updateTime"     column="update_time" />
        <result property="remark"         column="remark" />
    </resultMap>

    <sql id="selectWebhookVo">
        select webhook_id, repository_id, url, alias, secret_cipher, events, active,
               create_by, create_time, update_by, update_time, remark
        from sys_git_repository_webhook
    </sql>

    <select id="selectByRepositoryId" resultMap="SysGitRepositoryWebhookResult">
        <include refid="selectWebhookVo"/>
        where repository_id = #{repositoryId}
        order by webhook_id
    </select>

    <select id="selectByWebhookId" resultMap="SysGitRepositoryWebhookResult">
        <include refid="selectWebhookVo"/>
        where webhook_id = #{webhookId}
    </select>

    <select id="selectByRepositoryIdAndWebhookId" resultMap="SysGitRepositoryWebhookResult">
        <include refid="selectWebhookVo"/>
        where repository_id = #{repositoryId} and webhook_id = #{webhookId}
    </select>

    <insert id="insert" parameterType="com.cat2bug.common.domain.SysGitRepositoryWebhook" useGeneratedKeys="true" keyProperty="webhookId">
        insert into sys_git_repository_webhook (
            repository_id, url, alias, secret_cipher, events, active,
            create_by, create_time, update_by, update_time, remark
        ) values (
            #{repositoryId}, #{url}, #{alias}, #{secretCipher}, #{events}, #{active},
            #{createBy}, #{createTime}, #{updateBy}, #{updateTime}, #{remark}
        )
    </insert>

    <update id="update" parameterType="com.cat2bug.common.domain.SysGitRepositoryWebhook">
        update sys_git_repository_webhook
        set url = #{url},
            alias = #{alias},
            secret_cipher = #{secretCipher},
            events = #{events},
            active = #{active},
            update_by = #{updateBy},
            update_time = #{updateTime},
            remark = #{remark}
        where webhook_id = #{webhookId} and repository_id = #{repositoryId}
    </update>

    <delete id="deleteByRepositoryIdAndWebhookId">
        delete from sys_git_repository_webhook
        where repository_id = #{repositoryId} and webhook_id = #{webhookId}
    </delete>
</mapper>
