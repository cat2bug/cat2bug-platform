<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cat2bug.system.mapper.SysReportMapper">

    <resultMap id="SysReportResult" type="com.cat2bug.common.domain.SysReport">
        <result property="reportId" column="report_id"/>
        <result property="reportTitle" column="report_title"/>
        <result property="reportTime" column="report_time"/>
        <result property="reportDescription" column="report_description"/>
        <result property="reportDataCoder" column="report_data_coder"/>
        <result property="reportData" column="report_data"
                typeHandler="com.cat2bug.system.mybatis.JsonValueTypeHandler"/>
        <result property="createById" column="create_by_id"/>
        <result property="createBy" column="create_by"/>
        <result property="createByAvatar" column="create_by_avatar"/>
        <result property="projectId" column="project_id"/>
        <result property="reportSource" column="report_source"/>
        <result property="reportKey" column="report_key"/>
    </resultMap>

    <sql id="selectSysReportVo">
        select r.report_id, r.report_title, r.report_time, r.report_description, r.report_data_coder,
               r.report_data, r.create_by_id, r.project_id, r.report_source, r.report_key,
               u.nick_name as create_by, u.avatar as create_by_avatar
        from sys_report r
                 left join sys_user u on r.create_by_id = u.user_id
    </sql>

    <sql id="selectSysReportWhere">
        <where>
            <if test="query.projectId != null">
                and r.project_id = #{query.projectId}
            </if>
            <if test="query.reportTitle != null and query.reportTitle != ''">
                and r.report_title like concat('%', #{query.reportTitle}, '%')
            </if>
            <if test="query.reportDataCoder != null and query.reportDataCoder != ''">
                and r.report_data_coder = #{query.reportDataCoder}
            </if>
            <if test="query.createById != null">
                and r.create_by_id = #{query.createById}
            </if>
            <if test="query.createByIds != null and query.createByIds.size > 0">
                and r.create_by_id in
                <foreach collection="query.createByIds" item="id" separator="," open="(" close=")">
                    #{id}
                </foreach>
            </if>
        </where>
    </sql>

    <select id="countSysReportList" resultType="long">
        select count(*)
        from sys_report r
        <include refid="selectSysReportWhere"/>
    </select>

    <select id="selectSysReportList" resultMap="SysReportResult">
        <include refid="selectSysReportVo"/>
        <include refid="selectSysReportWhere"/>
        <bind name="_pageOrder" value="@com.cat2bug.framework.web.PageOrder@current()"/>
        <choose>
            <when test="_pageOrder != null">order by ${_pageOrder}</when>
            <otherwise>order by r.report_time desc</otherwise>
        </choose>
        limit #{limit} offset #{offset}
    </select>

    <select id="selectSysReportByReportId" resultMap="SysReportResult">
        <include refid="selectSysReportVo"/>
        where r.report_id = #{reportId}
    </select>

    <insert id="insertSysReport" useGeneratedKeys="true" keyProperty="reportId">
        insert into sys_report
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="reportId != null">report_id,</if>
            <if test="reportTitle != null and reportTitle != ''">report_title,</if>
            <if test="reportTime != null">report_time,</if>
            <if test="reportDescription != null">report_description,</if>
            <if test="reportDataCoder != null">report_data_coder,</if>
            <if test="reportData != null">report_data,</if>
            <if test="reportSource != null">report_source,</if>
            <if test="createById != null">create_by_id,</if>
            <if test="projectId != null">project_id,</if>
            <if test="reportKey != null">report_key,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="reportId != null">#{reportId},</if>
            <if test="reportTitle != null and reportTitle != ''">#{reportTitle},</if>
            <if test="reportTime != null">#{reportTime},</if>
            <if test="reportDescription != null">#{reportDescription},</if>
            <if test="reportDataCoder != null">#{reportDataCoder},</if>
            <if test="reportData != null">#{reportData, typeHandler=com.cat2bug.system.mybatis.JsonValueTypeHandler},</if>
            <if test="reportSource != null">#{reportSource},</if>
            <if test="createById != null">#{createById},</if>
            <if test="projectId != null">#{projectId},</if>
            <if test="reportKey != null">#{reportKey},</if>
        </trim>
    </insert>

    <update id="updateSysReport">
        update sys_report
        <trim prefix="SET" suffixOverrides=",">
            <if test="reportTitle != null and reportTitle != ''">report_title = #{reportTitle},</if>
            <if test="reportTime != null">report_time = #{reportTime},</if>
            <if test="reportDescription != null">report_description = #{reportDescription},</if>
            <if test="reportDataCoder != null">report_data_coder = #{reportDataCoder},</if>
            <if test="reportData != null">report_data = #{reportData, typeHandler=com.cat2bug.system.mybatis.JsonValueTypeHandler},</if>
            <if test="reportSource != null">report_source = #{reportSource},</if>
        </trim>
        where report_id = #{reportId}
    </update>

    <delete id="deleteSysReportByReportId">
        delete from sys_report where report_id = #{reportId}
    </delete>

    <delete id="deleteSysReportByReportIds">
        delete from sys_report where report_id in
        <foreach item="reportId" collection="reportIds" open="(" separator="," close=")">
            #{reportId}
        </foreach>
    </delete>
</mapper>
