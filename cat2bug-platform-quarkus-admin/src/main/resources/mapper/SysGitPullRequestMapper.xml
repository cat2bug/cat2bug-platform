<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cat2bug.quarkus.system.mapper.SysGitPullRequestMapper">

    <resultMap type="com.cat2bug.quarkus.common.domain.SysGitPullRequest" id="SysGitPullRequestResult">
        <result property="pullRequestId" column="pull_request_id"/>
        <result property="repositoryId"  column="repository_id"/>
        <result property="number"        column="number"/>
        <result property="title"         column="title"/>
        <result property="body"          column="body"/>
        <result property="sourceBranch"  column="source_branch"/>
        <result property="targetBranch"  column="target_branch"/>
        <result property="sourceSha"     column="source_sha"/>
        <result property="targetSha"     column="target_sha"/>
        <result property="state"         column="state"/>
        <result property="authorId"      column="author_id"/>
        <result property="mergedBy"      column="merged_by"/>
        <result property="mergedAt"      column="merged_at"/>
        <result property="closedAt"      column="closed_at"/>
        <result property="createBy"      column="create_by"/>
        <result property="createTime"    column="create_time"/>
        <result property="updateBy"      column="update_by"/>
        <result property="updateTime"    column="update_time"/>
        <result property="remark"        column="remark"/>
    </resultMap>

    <sql id="selectSysGitPullRequestVo">
        select pull_request_id, repository_id, number, title, body, source_branch, target_branch,
               source_sha, target_sha, state, author_id, merged_by, merged_at, closed_at,
               create_by, create_time, update_by, update_time, remark
        from sys_git_pull_request
    </sql>

    <insert id="insert" parameterType="com.cat2bug.quarkus.common.domain.SysGitPullRequest" useGeneratedKeys="true" keyProperty="pullRequestId">
        insert into sys_git_pull_request
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="repositoryId != null">repository_id,</if>
            <if test="number != null">number,</if>
            <if test="title != null">title,</if>
            <if test="body != null">body,</if>
            <if test="sourceBranch != null">source_branch,</if>
            <if test="targetBranch != null">target_branch,</if>
            <if test="sourceSha != null">source_sha,</if>
            <if test="targetSha != null">target_sha,</if>
            <if test="state != null">state,</if>
            <if test="authorId != null">author_id,</if>
            <if test="mergedBy != null">merged_by,</if>
            <if test="mergedAt != null">merged_at,</if>
            <if test="closedAt != null">closed_at,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="repositoryId != null">#{repositoryId},</if>
            <if test="number != null">#{number},</if>
            <if test="title != null">#{title},</if>
            <if test="body != null">#{body},</if>
            <if test="sourceBranch != null">#{sourceBranch},</if>
            <if test="targetBranch != null">#{targetBranch},</if>
            <if test="sourceSha != null">#{sourceSha},</if>
            <if test="targetSha != null">#{targetSha},</if>
            <if test="state != null">#{state},</if>
            <if test="authorId != null">#{authorId},</if>
            <if test="mergedBy != null">#{mergedBy},</if>
            <if test="mergedAt != null">#{mergedAt},</if>
            <if test="closedAt != null">#{closedAt},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <select id="selectById" parameterType="java.lang.Long" resultMap="SysGitPullRequestResult">
        <include refid="selectSysGitPullRequestVo"/>
        where pull_request_id = #{pullRequestId}
    </select>

    <select id="selectByRepoAndNumber" resultMap="SysGitPullRequestResult">
        <include refid="selectSysGitPullRequestVo"/>
        where repository_id = #{repositoryId}
          and number = #{number}
    </select>

    <select id="selectListByRepo" resultMap="SysGitPullRequestResult">
        <include refid="selectSysGitPullRequestVo"/>
        where repository_id = #{repositoryId}
        <if test="state != null and state != ''">
            and state = #{state}
        </if>
        order by number desc
    </select>

    <select id="selectOpenBySourceBranch" resultMap="SysGitPullRequestResult">
        <include refid="selectSysGitPullRequestVo"/>
        where repository_id = #{repositoryId}
          and source_branch = #{sourceBranch}
          and state = 'open'
    </select>

    <update id="updateStateFields" parameterType="com.cat2bug.quarkus.common.domain.SysGitPullRequest">
        update sys_git_pull_request
        <trim prefix="SET" suffixOverrides=",">
            <if test="state != null">state = #{state},</if>
            <if test="sourceSha != null">source_sha = #{sourceSha},</if>
            <if test="targetSha != null">target_sha = #{targetSha},</if>
            <if test="mergedBy != null">merged_by = #{mergedBy},</if>
            <if test="mergedAt != null">merged_at = #{mergedAt},</if>
            <if test="closedAt != null">closed_at = #{closedAt},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where pull_request_id = #{pullRequestId}
    </update>

    <select id="selectMaxNumberByRepo" parameterType="java.lang.Long" resultType="int">
        select coalesce(max(number), 0)
        from sys_git_pull_request
        where repository_id = #{repositoryId}
    </select>

</mapper>
