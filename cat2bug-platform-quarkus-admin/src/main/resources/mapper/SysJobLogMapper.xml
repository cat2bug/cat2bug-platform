<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cat2bug.quarkus.system.mapper.SysJobLogMapper">

    <resultMap id="SysJobLogResult" type="com.cat2bug.quarkus.common.domain.SysJobLog">
        <id property="jobLogId" column="job_log_id"/>
        <result property="jobName" column="job_name"/>
        <result property="jobGroup" column="job_group"/>
        <result property="invokeTarget" column="invoke_target"/>
        <result property="jobMessage" column="job_message"/>
        <result property="status" column="status"/>
        <result property="exceptionInfo" column="exception_info"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="selectJobLogVo">
        select job_log_id, job_name, job_group, invoke_target, job_message, status, exception_info, create_time
        from sys_job_log
    </sql>

    <sql id="jobLogListWhere">
        <where>
            <if test="query.jobName != null and query.jobName != ''">
                AND job_name like concat('%', #{query.jobName}, '%')
            </if>
            <if test="query.jobGroup != null and query.jobGroup != ''">
                AND job_group = #{query.jobGroup}
            </if>
            <if test="query.status != null and query.status != ''">
                AND status = #{query.status}
            </if>
            <if test="query.invokeTarget != null and query.invokeTarget != ''">
                AND invoke_target like concat('%', #{query.invokeTarget}, '%')
            </if>
            <if test="query.params.beginTime != null and query.params.beginTime != ''">
                AND CAST(create_time AS DATE) &gt;= CAST(#{query.params.beginTime} AS DATE)
            </if>
            <if test="query.params.endTime != null and query.params.endTime != ''">
                AND CAST(create_time AS DATE) &lt;= CAST(#{query.params.endTime} AS DATE)
            </if>
        </where>
    </sql>

    <select id="countJobLogList" resultType="long">
        select count(*) from sys_job_log
        <include refid="jobLogListWhere"/>
    </select>

    <select id="selectJobLogList" resultMap="SysJobLogResult">
        <include refid="selectJobLogVo"/>
        <include refid="jobLogListWhere"/>
        order by job_log_id desc
        limit #{limit} offset #{offset}
    </select>

    <select id="selectJobLogListAll" resultMap="SysJobLogResult">
        <include refid="selectJobLogVo"/>
        <include refid="jobLogListWhere"/>
        order by job_log_id desc
    </select>

    <select id="selectJobLogById" resultMap="SysJobLogResult">
        <include refid="selectJobLogVo"/>
        where job_log_id = #{jobLogId}
    </select>

    <insert id="insertJobLog">
        insert into sys_job_log (job_name, job_group, invoke_target, job_message, status, exception_info, create_time)
        values (#{jobName}, #{jobGroup}, #{invokeTarget}, #{jobMessage}, #{status}, #{exceptionInfo}, CURRENT_TIMESTAMP)
    </insert>

    <delete id="deleteJobLogByIds">
        delete from sys_job_log where job_log_id in
        <foreach collection="array" item="jobLogId" open="(" separator="," close=")">
            #{jobLogId}
        </foreach>
    </delete>

    <update id="cleanJobLog">
        truncate table sys_job_log
    </update>
</mapper>
