<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cat2bug.quarkus.system.mapper.SysReportTemplateMapper">

    <resultMap id="SysReportTemplateResult" type="com.cat2bug.quarkus.common.domain.SysReportTemplate">
        <result property="templateId" column="template_id"/>
        <result property="moduleType" column="module_type"/>
        <result property="templateContent" column="template_content"/>
        <result property="templateTitle" column="template_title"/>
        <result property="updateById" column="update_by_id"/>
        <result property="updateTime" column="update_time"/>
        <result property="projectId" column="project_id"/>
        <result property="templateIconUrl" column="template_icon_url"/>
        <result property="majorVersion" column="major_version"/>
        <result property="minorVersion" column="minor_version"/>
        <result property="templateKey" column="template_key"/>
    </resultMap>

    <sql id="selectSysReportTemplateVo">
        select template_id, module_type, template_content, template_title, update_by_id, update_time,
               project_id, template_icon_url, major_version, minor_version, template_key
    </sql>

    <sql id="selectSysReportTemplateWhere">
        from sys_report_template
        <where>
            <if test="query.moduleType != null and query.moduleType != ''">
                and module_type = #{query.moduleType}
            </if>
            <if test="query.templateTitle != null and query.templateTitle != ''">
                and template_title = #{query.templateTitle}
            </if>
            <if test="query.updateById != null">
                and update_by_id = #{query.updateById}
            </if>
            <if test="query.projectId != null">
                and project_id = #{query.projectId}
            </if>
            <if test="query.templateIconUrl != null and query.templateIconUrl != ''">
                and template_icon_url = #{query.templateIconUrl}
            </if>
            <if test="query.majorVersion != null">
                and major_version = #{query.majorVersion}
            </if>
            <if test="query.minorVersion != null">
                and minor_version = #{query.minorVersion}
            </if>
            <choose>
                <when test="query.isShop != null and query.isShop == true">
                    and is_shop = 1
                </when>
                <otherwise>
                    and is_shop != 1
                </otherwise>
            </choose>
            <if test="query.templateKey != null and query.templateKey != ''">
                and template_key = #{query.templateKey}
            </if>
        </where>
    </sql>

    <select id="countSysReportTemplateList" resultType="long">
        select count(*)
        <include refid="selectSysReportTemplateWhere"/>
    </select>

    <select id="selectSysReportTemplateList" resultMap="SysReportTemplateResult">
        <include refid="selectSysReportTemplateVo"/>
        <include refid="selectSysReportTemplateWhere"/>
        order by update_time desc
        limit #{limit} offset #{offset}
    </select>

    <select id="selectSysReportTemplateByTemplateId" resultMap="SysReportTemplateResult">
        <include refid="selectSysReportTemplateVo"/>
        from sys_report_template
        where template_id = #{templateId}
    </select>

    <insert id="insertSysReportTemplate" useGeneratedKeys="true" keyProperty="templateId">
        insert into sys_report_template
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="moduleType != null">module_type,</if>
            <if test="templateTitle != null">template_title,</if>
            <if test="templateContent != null">template_content,</if>
            <if test="updateById != null">update_by_id,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="projectId != null">project_id,</if>
            <if test="templateIconUrl != null">template_icon_url,</if>
            <if test="majorVersion != null">major_version,</if>
            <if test="minorVersion != null">minor_version,</if>
            <if test="templateKey != null and templateKey != ''">template_key,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="moduleType != null">#{moduleType},</if>
            <if test="templateTitle != null">#{templateTitle},</if>
            <if test="templateContent != null">#{templateContent},</if>
            <if test="updateById != null">#{updateById},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="projectId != null">#{projectId},</if>
            <if test="templateIconUrl != null">#{templateIconUrl},</if>
            <if test="majorVersion != null">#{majorVersion},</if>
            <if test="minorVersion != null">#{minorVersion},</if>
            <if test="templateKey != null and templateKey != ''">#{templateKey},</if>
        </trim>
    </insert>

    <update id="updateSysReportTemplate">
        update sys_report_template
        <trim prefix="SET" suffixOverrides=",">
            <if test="moduleType != null">module_type = #{moduleType},</if>
            <if test="templateTitle != null">template_title = #{templateTitle},</if>
            <if test="templateContent != null">template_content = #{templateContent},</if>
            <if test="updateById != null">update_by_id = #{updateById},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="projectId != null">project_id = #{projectId},</if>
            <if test="templateIconUrl != null">template_icon_url = #{templateIconUrl},</if>
            <if test="majorVersion != null">major_version = #{majorVersion},</if>
            <if test="minorVersion != null">minor_version = #{minorVersion},</if>
            <if test="templateKey != null and templateKey != ''">template_key = #{templateKey},</if>
        </trim>
        where template_id = #{templateId}
    </update>

    <delete id="deleteSysReportTemplateByTemplateId">
        delete from sys_report_template where template_id = #{templateId}
    </delete>

    <delete id="deleteSysReportTemplateByTemplateIds">
        delete from sys_report_template where template_id in
        <foreach item="templateId" collection="templateIds" open="(" separator="," close=")">
            #{templateId}
        </foreach>
    </delete>
</mapper>
