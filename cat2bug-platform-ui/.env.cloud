# 云部署环境（与 production 对齐，mode=cloud）
VUE_APP_TITLE = 猫陪我改BUG

ENV = 'production'
NODE_ENV = 'production'

VUE_APP_BASE_API = '/prod-api'
VUE_APP_STATIC_PATH = 'static'
VUE_APP_BASE_WEBSOCKET = '/ws'
VUE_APP_FILE_VIEW = '/file-view'

VUE_PUBLIC_PATH = '/'
VUE_APP_ENABLE_DEV_TOOLS = false

# 报告模版 Milkdown 可视化编辑器
VITE_REPORT_TEMPLATE_MILKDOWN = true
