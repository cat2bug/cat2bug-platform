{
  "name": "cat2bug",
  "version": "1.1.0",
  "description": "猫陪我改BUG",
  "author": "yuzhantao",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "CAT2BUG_DEV_HMR=1 vite --host",
    "build:prod": "vite build --mode production",
    "build:cloud": "vite build --mode cloud",
    "build:embedded": "vite build --mode embedded",
    "build:stage": "vite build --mode staging",
    "analyze": "ANALYZE=true vite build --mode embedded",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.vue src",
    "test:e2e": "playwright test",
    "test:e2e:local": "PLAYWRIGHT_NO_WEB_SERVER=1 PW_CHANNEL=chrome playwright test",
    "test:unit": "jest",
    "docs:dev": "vuepress dev docs",
    "docs:build": "vuepress build docs",
    "optimize:docs-images": "bash ../deploy/scripts/optimize-docs-images.sh",
    "optimize:docs-images:dry-run": "bash ../deploy/scripts/optimize-docs-images.sh --dry-run --report ../openspec/changes/prod-docs-images-slim/METRICS-dry-run.md",
    "check:docs-images": "bash ../deploy/scripts/check-docs-images.sh",
    "dedupe:docs-images": "bash ../deploy/scripts/dedupe-docs-images.sh",
    "dedupe:docs-images:dry-run": "bash ../deploy/scripts/dedupe-docs-images.sh --dry-run"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,vue}": [
      "eslint --fix",
      "git add"
    ]
  },
  "keywords": [
    "vue",
    "admin",
    "dashboard",
    "element-plus",
    "boilerplate",
    "admin-template",
    "management-system"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitee.com/cat2bug/cat2bug-platform.git"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@fontsource/dseg7-classic": "^5.2.5",
    "@svgdotjs/svg.js": "^3.2.0",
    "@unhead/vue": "^1.11.14",
    "axios": "1.7.4",
    "clipboard": "^2.0.11",
    "element-plus": "^2.9.5",
    "element-resize-detector": "^1.2.4",
    "file-saver": "^2.0.5",
    "fuse.js": "6.4.3",
    "highlight.js": "10.4.1",
    "html-docx-js": "^0.3.1",
    "html2canvas": "^1.4.1",
    "jquery": "^3.7.1",
    "js-base64": "^3.6.0",
    "js-beautify": "1.13.0",
    "js-cookie": "3.0.1",
    "js-md5": "^0.8.3",
    "js-web-screen-shot": "^1.9.9-rc.6",
    "jsencrypt": "3.0.0-rc.1",
    "jspdf": "^2.5.1",
    "markdown-it": "^14.1.1",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-container": "^4.0.0",
    "markdown-it-multimd-table": "^4.2.3",
    "markdown-it-table-of-contents": "^0.6.0",
    "markdown-it-toc": "^1.1.0",
    "md-editor-v3": "^5.8.5",
    "nprogress": "0.2.0",
    "pinia": "^2.3.1",
    "pubsub-js": "^1.9.5",
    "qrcode": "^1.5.3",
    "quill": "1.3.7",
    "screenfull": "5.0.2",
    "sortablejs": "1.10.2",
    "vue": "^3.5.13",
    "vue-count-to": "1.0.13",
    "vue-cropper": "^1.1.4",
    "vue-datepicker-next": "^1.0.3",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.5.0",
    "vuedraggable": "^4.1.0",
    "xlsx": "^0.17.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "babel-eslint": "10.1.0",
    "babel-jest": "^29.7.0",
    "eslint": "7.15.0",
    "eslint-plugin-vue": "^9.32.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "10.5.3",
    "sass": "^1.83.4",
    "unplugin-auto-import": "^0.19.0",
    "unplugin-vue-components": "^0.28.0",
    "vite": "^6.0.7",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-static-copy": "^2.2.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vuepress": "^1.9.10"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">= 9.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ]
}
