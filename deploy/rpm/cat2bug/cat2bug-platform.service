# Cat2Bug Platform — Native systemd unit（无 JRE 依赖）
[Unit]
Description=Cat2Bug Platform (Native)
Documentation=https://www.cat2bug.com
After=network.target

[Service]
Type=simple
User=root
# 安装配置 ./config/install 与 ./config/application.properties 均相对此目录解析
WorkingDirectory=/var/lib/cat2bug-platform
ExecStart=/usr/bin/cat2bug-admin
Environment=CAT2BUG_DISABLE_SELF_RESTART=true
# 安装向导提交后进程以 0 退出，须 always 才会被拉起
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
